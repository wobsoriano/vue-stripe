{
  "name": "vue-stripe",
  "type": "module",
  "version": "3.0.0",
  "packageManager": "pnpm@10.24.0",
  "description": "Vue components for Stripe.js and Stripe Elements",
  "author": "Robert Soriano <sorianorobertc@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/wobsoriano/vue-stripe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wobsoriano/vue-stripe.git"
  },
  "bugs": "https://github.com/wobsoriano/vue-stripe/issues",
  "keywords": [
    "vue",
    "stripe",
    "elements"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./checkout": {
      "types": "./dist/checkout/index.d.ts",
      "import": "./dist/checkout/index.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt/module.d.ts",
      "import": "./dist/nuxt/module.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsdown --watch --onSuccess \"pnpm build:dts\"",
    "build": "tsdown --env.NODE_ENV production",
    "postbuild": "node scripts/check-nuxt-build-artifacts.mjs",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "pnpm build && changeset publish",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@nuxt/kit": "^4.0.0",
    "@stripe/stripe-js": ">=9.5.0 <10.0.0",
    "stripe": ">=17.0.0",
    "vue": "^3.2.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "stripe": {
      "optional": true
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@changesets/cli": "^2.29.8",
    "@nuxt/kit": "^4.5.2",
    "@stripe/stripe-js": "^9.13.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/compiler-dom": "^3.5.29",
    "@vue/compiler-sfc": "^3.5.29",
    "@vue/server-renderer": "^3.5.29",
    "eslint": "^9.39.1",
    "h3": "2.0.1-rc.26",
    "jsdom": "^27.2.0",
    "nuxt": "^4.2.1",
    "stripe": "^22.5.0",
    "tsdown": "^0.15.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vue": "^3.5.25",
    "vue-composable-testing": "^0.2.0"
  }
}
